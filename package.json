{
  "name": "dq-player-bot",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Local DegenQuest player bot with a native first-person viewer and Claude operator tools",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node bin/claude.mjs",
    "setup": "node bin/setup.mjs",
    "check": "node bin/player.mjs check --config .secrets/player.local.json",
    "service": "node bin/service.mjs",
    "console": "node bin/console.mjs --open",
    "renderer:install": "node scripts/install-renderer.mjs",
    "app:build": "node scripts/build-local-app.mjs",
    "bootstrap": "npm run renderer:install && npm run app:build",
    "audit:public": "node scripts/audit-public.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coinmastersguild/dq-player-bot.git"
  },
  "homepage": "https://github.com/coinmastersguild/dq-player-bot",
  "bugs": {
    "url": "https://github.com/coinmastersguild/dq-player-bot/issues"
  }
}
